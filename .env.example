# Copy these settings into .env on the Raspberry Pi. Do not commit .env.
DISCORD_WEBHOOK_URL=
SHOPIFY_STORES=https://boutique1.example,https://boutique2.example
# Optional persistent public dashboard tunnel (ngrok account required).
# The domain shown in the ngrok onboarding screenshot is used by default.
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=tweed-popular-pledge.ngrok-free.dev
# Optional eBay Browse API credentials for current French-market listing estimates.
# These are not MSRP values; never commit real credentials.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
